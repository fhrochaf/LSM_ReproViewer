<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LARSIM ReproChecker — Reproducible Studies</title>
  <link rel="stylesheet" href="static/style.css">
</head>
<body>
  <div class="page">
    <header class="site-header">
      <div>
        <span class="site-header__eyebrow">LARSIM ReproChecker</span>
        <h1 class="site-header__title">Reproducible landslide mapping studies</h1>
        <p class="site-header__subtitle">
          Publications whose datasets and methods were assessed as reproducible or partially
          reproducible: the data and/or code needed to reproduce the results are available,
          fully or in part.
        </p>
      </div>
      <div class="stat-row">
        <div class="stat">
          <span class="stat__value">{{ reproducible_count }}</span>
          <span class="stat__label">Reproducible</span>
        </div>
        <div class="stat">
          <span class="stat__value">{{ partial_count }}</span>
          <span class="stat__label">Partially reproducible</span>
        </div>
        <div class="stat">
          <span class="stat__value">{{ total_count }}</span>
          <span class="stat__label">Assessed</span>
        </div>
      </div>
    </header>

    <div class="controls">
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search by title, author, dataset, or method…"
        autocomplete="off"
      >
      <span id="result-count" class="result-count"></span>
    </div>

    <div id="class-filter" class="filter-row" aria-label="Filter by method class"></div>

    <main id="card-grid" class="card-grid"></main>

    <footer class="site-footer">
      Generated by <code>reprochecker_viewer/build.py</code> from
      <code>output_fullPDF_with_guardrails_singlePDFread/</code>. Re-run the build script after new
      assessments are produced.
    </footer>
  </div>

  <div id="modal-backdrop" class="modal-backdrop">
    <div class="modal" role="dialog" aria-modal="true">
      <button id="modal-close" class="modal__close" aria-label="Close">&times;</button>
      <div id="modal-body"></div>
    </div>
  </div>

  <script id="papers-data" type="application/json">{{ papers_json|safe }}</script>
  <script src="static/script.js"></script>
</body>
</html>
